}

/* headliner */
.headliner {
  margin: -6px 0 14px; padding: 18px; border-radius: 22px; color: #fff; position: relative; overflow: hidden;
  background: radial-gradient(120% 140% at 100% 0%, #ff8a3d 0%, #ff5a4e 35%, #c2185b 70%, #4a1a8a 100%);
  box-shadow: 0 10px 30px rgba(194, 24, 91, .35);
}
.headliner::before {
  content: "★"; position: absolute; right: -10px; top: -34px; font-size: 170px; color: rgba(255,255,255,.12); line-height: 1;
}
.hl-top { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; position: relative; }
.hl-when { font-size: 13.5px; opacity: .92; font-weight: 500; }
.hl-name { font-size: 34px; font-weight: 800; letter-spacing: -.8px; line-height: 1.05; margin-top: 10px; position: relative; }
.hl-title { opacity: .85; font-size: 14px; margin-top: 2px; position: relative; }
.cd { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 14px 0 10px; position: relative; }
.cd > div { background: rgba(255,255,255,.16); border-radius: 14px; padding: 8px 4px; text-align: center; backdrop-filter: blur(4px); }
.cd b { display: block; font-size: 30px; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.1; }
.cd span { font-size: 11.5px; opacity: .85; text-transform: lowercase; }
.hl-hype { margin: 0 0 12px; font-size: 15px; font-weight: 500; position: relative; }
.btn.light { background: rgba(255,255,255,.2); color: #fff; }
.btn.light:hover { background: rgba(255,255,255,.3); }
.btn.coral:hover { background: #ff7268; }
.hl-prep { margin-top: 12px; background: rgba(0,0,0,.14); border-radius: 14px; padding: 10px 12px; position: relative; }
.hl-prep summary { cursor: pointer; font-weight: 600; font-size: 14px; }
.hl-prep .check { margin-top: 8px; font-size: 14px; }
.hl-prep .light-ghost { color: #fff; margin-top: 6px; text-decoration: underline; padding-left: 0; }
.chip.star { background: #ffc23d; color: #4a2a00; font-weight: 700; }
.chip.star-cd { background: #fff1d6; color: #9a4b00; font-variant-numeric: tabular-nums; font-weight: 600; }
.t-card.featured {
  border-left-color: #ff8a3d; background: linear-gradient(135deg, #fff8ec, #ffeef0);
  box-shadow: 0 0 0 2px #ffc23d, var(--shadow);
}
.t-card.featured .t-title { font-size: 17px; }
.hl-strip {
  display: flex; width: 100%; align-items: center; justify-content: center; gap: 8px; border: 0; cursor: pointer;
  background: linear-gradient(90deg, #ff5a4e, #c2185b); color: #fff; font-weight: 600; font-size: 14px; padding: 8px 12px;
  position: sticky; top: 68px; z-index: 19;
}
.hl-strip b { font-variant-numeric: tabular-nums; }
.alert-pop {
  position: fixed; inset: 0; z-index: 70; background: rgba(10, 16, 51, .55); display: grid; place-items: center; padding: 20px; animation: fade .2s;
}
.alert-card {
  background: radial-gradient(120% 140% at 100% 0%, #ff8a3d 0%, #ff5a4e 35%, #c2185b 75%, #4a1a8a 100%);
  color: #fff; border-radius: 26px; padding: 26px 22px; max-width: 380px; width: 100%; text-align: center; animation: pop .35s cubic-bezier(.2, 1.4, .4, 1);
  box-shadow: 0 20px 60px rgba(0,0,0,.35);
}
.alert-card p { font-size: 17px; margin: 8px 0 18px; }
.alert-burst { font-size: 56px; color: #ffc23d; animation: spin 2.4s linear infinite; display: inline-block; }
.alert-title { font-size: 22px; font-weight: 800; letter-spacing: -.3px; }
@keyframes pop { from { transform: scale(.7); opacity: 0; } to { transform: none; opacity: 1; } }
@keyframes spin { to { transform: rotate(360deg); } }

/* agents */
.agent-row { display: flex; gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--line); }
.agent-row:last-of-type { border-bottom: 0; }
