<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <script>try{const s=JSON.parse(localStorage.getItem('r4-networking-v1')||'null');document.documentElement.dataset.brand=s?.me?.brand==='aigovops'?'aigovops':'slalom'}catch{document.documentElement.dataset.brand='slalom'}</script>
  <meta name="theme-color" content="#0c2bd8" />
  <title>r4 networking</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22%3E%3Crect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%230c2bd8%22/%3E%3Ctext x=%2216%22 y=%2222%22 font-size=%2216%22 font-family=%22sans-serif%22 font-weight=%22700%22 fill=%22white%22 text-anchor=%22middle%22%3Er4%3C/text%3E%3C/svg%3E" />
  <style>
:root {
  --blue: #0c2bd8;
  --blue-bright: #1e5bff;
  --blue-soft: #e8eeff;
  --navy: #0a1033;
  --ink: #141a3a;
  --muted: #5d6585;
  --line: #dfe4f3;
  --bg: #f5f7fd;
  --card: #ffffff;
  --coral: #ff5a4e;
  --sun: #ffc23d;
  --mint: #18c39a;
  --violet: #8b5cf6;
  --sky: #3fb6ff;
  --radius: 18px;
  --shadow: 0 1px 2px rgba(10, 16, 51, .06), 0 6px 18px rgba(10, 16, 51, .06);
  --font: "Outfit", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
:root[data-brand="slalom"] {
  --blue:#0C62FB;--blue-bright:#002FAF;--blue-soft:#EAF1FF;--navy:#000A25;--ink:#292929;--muted:#5C5C5C;--line:#E6E6E6;--bg:#F5F5F5;--card:#FFFFFF;--coral:#FF4D5F;--sun:#DEFF4D;--mint:#1BE1F2;--violet:#C7B9FF;--sky:#1BE1F2;--radius:.625rem;
}
:root[data-brand="aigovops"] {
  --blue:#6C3DE6;--blue-bright:#4A1FB8;--blue-soft:#EDE9FF;--navy:#0D0D1A;--ink:#2D2D4E;--muted:#5B6280;--line:#E0DDF5;--bg:#F8F7FF;--card:#FFFFFF;--coral:#B4232A;--sun:#854F0B;--mint:#1D9E75;--violet:#6C3DE6;--sky:#4A1FB8;--radius:12px;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: var(--font);
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
}
button, input, select, textarea { font-family: inherit; font-size: inherit; color: inherit; }
button, input:not([type=checkbox]):not([type=radio]), select, textarea, [role=button], [role=radio] { min-height: 44px; }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, [tabindex]:focus-visible { outline: 3px solid var(--blue-bright); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }
.brand-picker { border: 1px solid var(--line); border-radius: 14px; padding: 12px; display: flex; gap: 8px; flex-wrap: wrap; }
.brand-picker legend { font-weight: 700; padding: 0 6px; }
.brand-picker [role=radio] { flex: 1; min-width: 120px; border: 1px solid var(--line); border-radius: 999px; background: var(--card); padding: 10px 14px; font-weight: 600; }
.brand-picker [role=radio][aria-checked=true] { background: var(--blue-soft); border-color: var(--blue); color: var(--navy); }
.icon-btn { min-width: 44px; min-height: 44px; }
.receipt-panel { border: 1px solid var(--line); border-radius: 16px; padding: 12px; }
.receipt-list { display: grid; gap: 8px; }
.receipt-row { width: 100%; min-height: 56px; text-align: left; display: grid; grid-template-columns: 1fr auto; gap: 2px 8px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); color: var(--ink); overflow-wrap: anywhere; }
.receipt-row small { grid-column: 1 / -1; color: var(--muted); }
.app {
  max-width: 520px;
  margin: 0 auto;
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 0 0 40px rgba(10, 16, 51, .12);
}
.topbar {
  position: sticky; top: 0; z-index: 20;
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 18px;
  background: var(--blue);
  color: #fff;
}
.brand { display: flex; align-items: baseline; gap: 8px; }
.brand-mark {
  font-weight: 800; font-size: 26px; letter-spacing: -1px;
  background: #fff; color: var(--blue); border-radius: 10px; padding: 0 8px; line-height: 34px;
}
.brand-text { font-weight: 500; font-size: 20px; letter-spacing: .2px; }
.icon-btn {
  background: rgba(255,255,255,.14); border: 0; color: inherit; width: 40px; height: 40px;
  border-radius: 50%; display: grid; place-items: center; cursor: pointer;
}
.icon-btn:hover { background: rgba(255,255,255,.24); }
.view { flex: 1; padding: 0 16px 110px; }

/* tabbar */
.tabbar {
  position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 100%; max-width: 520px; z-index: 30;
  display: grid; grid-template-columns: repeat(8, 1fr);
  background: #fff; border-top: 1px solid var(--line);
  padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
}
.tab {
  background: none; border: 0; cursor: pointer; padding: 6px 0 4px;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  color: var(--muted); font-size: 10px; font-weight: 500; border-radius: 12px; white-space: nowrap; min-width: 0;
}
.tab svg { width: 22px; height: 22px; }
.tab.active { color: var(--blue); }
.tab.active .tab-ico { background: var(--blue-soft); }
.tab-ico { padding: 3px 9px; border-radius: 999px; display: grid; place-items: center; }

/* hero */
.hero {
  margin: 0 -16px 16px; padding: 20px 20px 26px;
  background: var(--blue); color: #fff; position: relative; overflow: hidden;
}
.hero::after {
  content: ""; position: absolute; right: -40px; top: -30px; width: 180px; height: 180px;
  border-radius: 50%; border: 28px solid rgba(255,255,255,.08);
}
.hero h1 { margin: 0 0 4px; font-size: 30px; font-weight: 700; letter-spacing: -.5px; line-height: 1.1; }
.hero p { margin: 0; opacity: .85; font-size: 15px; }
.hero .day-pill { margin-top: 14px; }

h2.section {
  font-size: 19px; font-weight: 700; margin: 22px 2px 10px; letter-spacing: -.2px;
  display: flex; justify-content: space-between; align-items: center;
}
h2.section small { font-size: 13px; color: var(--muted); font-weight: 500; }
.page-title { font-size: 28px; font-weight: 700; letter-spacing: -.5px; margin: 18px 2px 4px; }
.page-sub { color: var(--muted); margin: 0 2px 14px; font-size: 15px; }

.card {
  background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow);
  padding: 16px; margin-bottom: 12px;
}
.card.tight { padding: 12px 14px; }
.card h3 { margin: 0 0 6px; font-size: 17px; font-weight: 600; }
.card p { margin: 0; }
.muted { color: var(--muted); }
.small { font-size: 13px; }
.row { display: flex; align-items: center; gap: 10px; }
.row.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.stack > * + * { margin-top: 10px; }

.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 12px; }
.stat { background: #fff; border-radius: 16px; padding: 12px; box-shadow: var(--shadow); }
.stat b { display: block; font-size: 26px; font-weight: 700; color: var(--blue); line-height: 1.1; }
.stat span { font-size: 12.5px; color: var(--muted); }

.progress { height: 8px; background: var(--blue-soft); border-radius: 999px; overflow: hidden; margin-top: 8px; }
.progress > i { display: block; height: 100%; background: var(--blue-bright); border-radius: 999px; transition: width .3s; }

/* buttons */
.btn {
  border: 0; cursor: pointer; border-radius: 999px; padding: 11px 18px; font-weight: 600;
  background: var(--blue); color: #fff; display: inline-flex; align-items: center; gap: 8px; justify-content: center;
  transition: transform .05s, background .15s;
}
.btn:hover { background: var(--blue-bright); }
.btn:active { transform: scale(.98); }
.btn.secondary { background: var(--blue-soft); color: var(--navy); }
.btn.secondary:hover { background: #dbe4ff; }
.btn.ghost { background: transparent; color: var(--blue); padding: 8px 10px; }
.btn.danger { background: #ffe8e6; color: #c0281d; }
.btn.coral { background: var(--coral); }
.btn.sm { padding: 7px 12px; font-size: 13.5px; }
.btn.block { width: 100%; }
.btn[disabled] { opacity: .5; cursor: not-allowed; }
button, input:not([type="hidden"]), select, textarea, [role="button"], [role="radio"], [role="switch"], [role="tab"] { min-width: 44px; min-height: 44px; }
input[type="checkbox"], input[type="radio"] { width: 44px; height: 44px; }
a[href] { min-height: 44px; }
a[href] { display: inline-flex; min-width: 44px; align-items: center; }
p a[href] { display: inline; min-width: 0; min-height: 0; }
.fab {
  position: fixed; bottom: 86px; z-index: 25;
  right: max(16px, calc(50% - 260px + 16px));
  width: 58px; height: 58px; border-radius: 50%; border: 0; cursor: pointer;
  background: var(--coral); color: #fff; box-shadow: 0 8px 20px rgba(255, 90, 78, .4);
  display: grid; place-items: center;
}
.fab svg { width: 28px; height: 28px; }

/* chips */
.chips { display: flex; gap: 6px; flex-wrap: wrap; }
.chip {
  display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 999px;
  background: var(--blue-soft); color: var(--navy); font-size: 12.5px; font-weight: 500; border: 0;
}
button.chip { cursor: pointer; }
.chip.on { background: var(--navy); color: #fff; }
.chip.warn { background: #fff1d6; color: #9a6200; }
.chip.bad { background: #ffe8e6; color: #c0281d; }
.chip.good { background: #dcf7ef; color: #0b7d61; }
.seg {
  display: flex; background: #e7ebf7; border-radius: 999px; padding: 4px; gap: 4px; margin-bottom: 14px;
  overflow-x: auto;
}
.seg button {
  flex: 1; border: 0; background: none; padding: 8px 10px; border-radius: 999px; cursor: pointer;
  font-weight: 600; color: var(--muted); white-space: nowrap; font-size: 14px;
}
.seg button.on { background: #fff; color: var(--navy); box-shadow: var(--shadow); }
.scroller { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin-bottom: 12px; }
.scroller::-webkit-scrollbar { display: none; }
.scroller .chip { white-space: nowrap; flex: none; }

/* persona colors */
.p-exec { --pc: var(--blue); }
.p-tech { --pc: var(--violet); }
.p-peer { --pc: var(--mint); }
.p-client { --pc: var(--coral); }
.p-partner { --pc: var(--sky); }
.p-talent { --pc: #e09a00; }
.p-cos { --pc: #d946ef; }
.avatar {
  width: 44px; height: 44px; border-radius: 50%; flex: none;
  background: var(--pc, var(--blue)); color: #fff; display: grid; place-items: center;
  font-weight: 700; font-size: 16px;
}
.avatar.p-peer { color: var(--navy); }
.avatar.p-client, .avatar.p-partner { color: #000; }
:root[data-brand="aigovops"] .avatar.p-client, :root[data-brand="aigovops"] .avatar.p-partner { color: #fff; }
.avatar.lg { width: 64px; height: 64px; font-size: 24px; }
.persona-tag {
  display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600;
  color: var(--pc); background: color-mix(in srgb, var(--pc) 12%, white); padding: 3px 10px; border-radius: 999px;
}
.persona-tag::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--pc); }

.list-item {
  display: flex; gap: 12px; align-items: center; padding: 12px 14px; background: #fff;
  border-radius: 16px; box-shadow: var(--shadow); margin-bottom: 8px; cursor: pointer; border: 0; width: 100%; text-align: left;
}
.list-item:hover { box-shadow: 0 0 0 2px var(--blue-soft), var(--shadow); }
.list-item .name { font-weight: 600; font-size: 16px; }
.list-item .sub { color: var(--muted); font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.search {
  width: 100%; border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 11px 16px;
  outline: none; margin-bottom: 10px;
}
.search:focus { border-color: var(--blue-bright); box-shadow: 0 0 0 3px var(--blue-soft); }

/* forms */
.field { margin-bottom: 12px; }
.field label { display: block; font-size: 13px; font-weight: 600; color: var(--muted); margin-bottom: 5px; }
.field input, .field select, .field textarea {
  width: 100%; border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; background: #fff; outline: none;
}
.field textarea { min-height: 76px; resize: vertical; }
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--blue-bright); box-shadow: 0 0 0 3px var(--blue-soft); }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.check { display: flex; gap: 8px; align-items: center; font-weight: 500; }

/* sheet */
.sheet-backdrop {
  position: fixed; inset: 0; background: rgba(10, 16, 51, .45); z-index: 50;
  display: flex; align-items: flex-end; justify-content: center; animation: fade .15s;
}
.sheet {
  background: var(--bg); width: 100%; max-width: 520px; max-height: 92vh; overflow-y: auto;
  border-radius: 24px 24px 0 0; padding: 8px 18px 28px; animation: up .2s ease-out;
}
.sheet-handle { width: 44px; height: 5px; border-radius: 9px; background: #c6cde3; margin: 6px auto 10px; }
.sheet-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.sheet-head h2 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -.3px; }
@keyframes up { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }

.toast {
  position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%) translateY(20px);
  background: var(--navy); color: #fff; padding: 10px 18px; border-radius: 999px; font-size: 14px; font-weight: 500;
  opacity: 0; pointer-events: none; transition: all .2s; z-index: 60; max-width: 90vw;
}
.toast.show { opacity: 1; transform: translateX(-50%); }

/* timeline */
.timeline { position: relative; }
.t-item {
  display: grid; grid-template-columns: 58px 1fr; gap: 10px; margin-bottom: 8px;
}
.t-time { font-size: 13px; color: var(--muted); font-weight: 600; padding-top: 12px; text-align: right; }
.t-card {
  background: #fff; border-radius: 14px; padding: 11px 13px; box-shadow: var(--shadow);
  border-left: 5px solid var(--tc, var(--blue)); cursor: pointer;
}
.t-card .t-title { font-weight: 600; }
.t-card .t-meta { font-size: 13px; color: var(--muted); }
.t-session { --tc: var(--blue); }
.t-bof { --tc: var(--mint); }
.t-work { --tc: #8a93b2; background: repeating-linear-gradient(-45deg, #fff, #fff 8px, #f6f7fb 8px, #f6f7fb 16px); }
.t-pitch { --tc: var(--coral); }
.t-social { --tc: var(--sun); }
.t-meeting { --tc: var(--violet); }
.t-card.conflict { box-shadow: 0 0 0 2px #ff8f86, var(--shadow); }
.t-free .t-card {
  background: transparent; box-shadow: none; border: 2px dashed #b9c5ef; border-left-width: 2px; color: var(--blue);
  padding: 8px 12px;
}
.legend { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12.5px; color: var(--muted); margin-bottom: 12px; }
.legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 4px; vertical-align: -1px; }

.warn-box { background: #fff6e4; border-radius: 14px; padding: 10px 14px; margin-bottom: 12px; color: #7a4e00; font-size: 14px; }
.warn-box b { display: block; margin-bottom: 2px; }
.warn-box ul { margin: 4px 0 0; padding-left: 18px; }

/* pitch */
.pitch-stage {
  background: var(--navy); color: #fff; border-radius: 24px; padding: 22px 18px; text-align: center; margin-bottom: 14px;
  position: relative; overflow: hidden;
}
.ring { width: 230px; height: 230px; margin: 4px auto 10px; position: relative; }
.ring svg { transform: rotate(-90deg); width: 100%; height: 100%; }
.ring .clock {
  position: absolute; inset: 0; display: grid; place-items: center; font-size: 64px; font-weight: 700; letter-spacing: -2px;
  font-variant-numeric: tabular-nums;
}
.pitch-stage.hurry .clock { color: var(--sun); }
.pitch-stage.over .clock { color: var(--coral); animation: pulse 1s infinite; }
@keyframes pulse { 50% { opacity: .4; } }
.pitch-now { font-size: 14px; opacity: .7; text-transform: lowercase; letter-spacing: .5px; }
.pitch-name { font-size: 22px; font-weight: 700; margin: 2px 0; }
.pitch-idea { opacity: .85; font-size: 15px; margin-bottom: 12px; }
.pitch-controls { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
.pitch-stage .btn.secondary { background: rgba(255,255,255,.12); color: #fff; }

/* web */
.web-wrap { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; margin-bottom: 12px; }
.web-wrap svg { display: block; width: 100%; height: auto; touch-action: manipulation; }
.web-node-topic circle { fill: var(--blue); }
.web-node-topic text { fill: #fff; font-weight: 600; font-size: 11px; pointer-events: none; }
.web-node-person text { font-size: 10.5px; fill: var(--ink); pointer-events: none; font-weight: 500; }
.web-node { cursor: pointer; transition: opacity .2s; }
.web-edge { stroke: #c9d3f3; stroke-width: 1.4; transition: opacity .2s; }
.web-dim { opacity: .12; }
.web-edge.hl { stroke: var(--blue-bright); stroke-width: 2.2; }

.group-card { border-top: 5px solid var(--gc, var(--blue)); }
.match-score { font-weight: 700; color: var(--blue); font-size: 18px; min-width: 42px; text-align: right; }

.report { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px; font-size: 14.5px; line-height: 1.5; }
.report h3 { font-size: 17px; margin: 18px 0 6px; color: var(--blue); }
.report h3:first-child { margin-top: 0; }
.report ul { padding-left: 18px; margin: 4px 0; }
.report .report-head { border-bottom: 2px solid var(--blue-soft); padding-bottom: 10px; margin-bottom: 8px; }
.report .report-head b { font-size: 20px; display: block; }

.empty { text-align: center; padding: 30px 16px; color: var(--muted); }
.empty b { display: block; color: var(--ink); font-size: 17px; margin-bottom: 4px; }

.kv { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; font-size: 14px; }
.kv dt { color: var(--muted); }
.kv dd { margin: 0; }
.resource { display: flex; gap: 10px; padding: 9px 0; border-top: 1px solid var(--line); font-size: 14px; }
.resource:first-child { border-top: 0; }
.resource .ico { width: 30px; height: 30px; border-radius: 9px; background: var(--blue-soft); color: var(--blue); display: grid; place-items: center; flex: none; font-size: 15px; }
.template-box { background: var(--bg); border-radius: 12px; padding: 12px; font-size: 14px; white-space: pre-wrap; border: 1px solid var(--line); }
.vote { display: flex; flex-direction: column; align-items: center; min-width: 44px; }
.vote button { border: 0; background: var(--blue-soft); color: var(--blue); border-radius: 10px; width: 40px; height: 32px; cursor: pointer; font-weight: 700; }
.vote button.on { background: var(--blue); color: #fff; }
.vote span { font-weight: 700; font-size: 14px; margin-top: 2px; }
.goal-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-top: 1px solid var(--line); }
.goal-row:first-of-type { border-top: 0; }
.stepper { display: flex; align-items: center; gap: 6px; }
.stepper button { width: 30px; height: 30px; border-radius: 50%; border: 0; background: var(--blue-soft); color: var(--blue); font-weight: 700; cursor: pointer; }

@media print {
  body { background: #fff; }
  .topbar, .tabbar, .fab, .no-print, #sheet-root { display: none !important; }
  .app { box-shadow: none; max-width: none; }
  .view { padding: 0; }
  .report { box-shadow: none; }
}

/* language switch */
.lang-switch { display: flex; background: rgba(255,255,255,.14); border-radius: 999px; padding: 3px; gap: 2px; }
.lang-switch button { min-width: 44px; min-height: 44px; border: 0; background: #fff; color: var(--navy); font-weight: 600; font-size: 12.5px; padding: 6px 9px; border-radius: 999px; cursor: pointer; }
.lang-switch button.on { background: var(--navy); color: #fff; }
.topbar-right { display: flex; align-items: center; gap: 8px; }
@media (max-width: 520px) {
  .topbar { flex-wrap: wrap; align-items: flex-start; gap: 10px; }
  .brand { flex: 1 1 100%; flex-wrap: wrap; align-items: center; min-width: 0; }
  .brand-mark { display: inline-flex; align-items: center; min-height: 44px; line-height: 1.2; }
  .brand-text { min-width: 0; overflow-wrap: anywhere; }
  .topbar-right { flex: 1 1 100%; justify-content: space-between; flex-wrap: wrap; min-width: 0; }
  .lang-switch { max-width: 100%; flex-wrap: wrap; }
  .field-row { grid-template-columns: minmax(0, 1fr); }
  .field, .field-row, .field .row { min-width: 0; }
  .field input, .field select, .field textarea { min-width: 0; max-width: 100%; }
