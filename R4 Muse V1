    if (g && (p.persona === 'exec' || p.persona === 'client') && goalValue(g) < g.target) { s += W.goal; reasons.push(t('fits goal: execs & clients')); }
    if (p.priority === 'hot') { s += W.hot; reasons.push(t('flagged hot')); } else if (p.priority === 'warm') s += 6;
    const bridges = met().filter((m) => m.id !== p.id && m.topics.some((x) => p.topics.includes(x))).length;
    if (bridges) { s += Math.min(15, bridges * W.bridges); reasons.push(t('connects to {n} of your contacts', { n: bridges })); }
